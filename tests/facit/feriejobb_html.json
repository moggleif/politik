   "html": "<thead><tr><th scope=\"col\">Grupp och ålder</th><th scope=\"col\">2023</th><th scope=\"col\">2024</th><th scope=\"col\">2025</th><th scope=\"col\">2026</th></tr></thead><tbody><tr><th scope=\"row\">Feriejobb, tillsatta i hela kommunen<br><small>Gymnasieettor</small></th><td>199 <a class=\"fotnot\" href=\"#kalla-4\" aria-label=\"Källa 4\">[4]</a></td><td>200 <a class=\"fotnot\" href=\"#kalla-5\" aria-label=\"Källa 5\">[5]</a><a class=\"fotnot\" href=\"#kalla-6\" aria-label=\"Källa 6\">[6]</a><a class=\"fotnot\" href=\"#kalla-7\" aria-label=\"Källa 7\">[7]</a></td><td>200 <a class=\"fotnot\" href=\"#kalla-8\" aria-label=\"Källa 8\">[8]</a><a class=\"fotnot\" href=\"#kalla-11\" aria-label=\"Källa 11\">[11]</a></td><td>224 <a class=\"fotnot\" href=\"#kalla-12\" aria-label=\"Källa 12\">[12]</a><a class=\"fotnot\" href=\"#kalla-13\" aria-label=\"Källa 13\">[13]</a></td></tr><tr><th scope=\"row\">17-åringar<br><small>Ålder: 17 år; inför sommaren 2023 också 16-åringar som fyllde 17 under året <a class=\"fotnot\" href=\"#kalla-20\" aria-label=\"Källa 20\">[20]</a></small></th><td>40 <a class=\"fotnot\" href=\"#kalla-14\" aria-label=\"Källa 14\">[14]</a></td><td>58 <a class=\"fotnot\" href=\"#kalla-15\" aria-label=\"Källa 15\">[15]</a></td><td>50 <a class=\"fotnot\" href=\"#kalla-16\" aria-label=\"Källa 16\">[16]</a></td><td>–</td></tr><tr><th scope=\"row\">Riktade lovjobb<br><small>Ålder: gymnasieelever, åldern anges inte</small></th><td>19 <a class=\"fotnot\" href=\"#kalla-17\" aria-label=\"Källa 17\">[17]</a></td><td>12 <a class=\"fotnot\" href=\"#kalla-15\" aria-label=\"Källa 15\">[15]</a></td><td>–</td><td>–</td></tr><tr><th scope=\"row\">Sommarvikarier på schema<br><small>Ålder: anges inte i handlingarna</small></th><td>312 av 437 beställda <a class=\"fotnot\" href=\"#kalla-18\" aria-label=\"Källa 18\">[18]</a><br><small>och omkring 300 som bara anmält sig tillgängliga</small><br><small>Läget i slutet av maj 2023, före sommaren.</small></td><td>375 av 380 b