 "sommarjobb": {
  "grupper": [
   {"id": "17-aringar", "namn": "17-åringar", "forklaring": "Ungdomar som anställs för sommaren, främst på vård- och omsorgsboenden men också i hemtjänsten. De gör serviceuppgifter som avlastar personalen.", "alder": "17 år; inför sommaren 2023 också 16-åringar som fyllde 17 under året", "alder_kalla": "vo-rev2023", "alder_citat": "Inför sommaren 2023 kommer också 16- åringar som fyller 17 år under 2023 samt 17 åringar anställas för att utföra serviceuppgifter"},
   {"id": "lovjobb", "namn": "Riktade lovjobb", "forklaring": "Gymnasieelever på Vård- och omsorgsprogrammet som arbetar i förvaltningen under loven, inte bara på sommaren. Talet gäller hela året.", "alder": "gymnasieelever, åldern anges inte", "alder_kalla": null, "alder_citat": null},
   {"id": "vikarier", "namn": "Sommarvikarier på schema", "forklaring": "Timvikarier inom omvårdnaden som fått förbokade veckor och pass under sommaren, av dem verksamheterna beställde. Vikarier som bara anmält sig tillgängliga för enstaka pass räknas inte in, men står inom parentes där de redovisats.", "alder": "anges inte i handlingarna", "alder_kalla": null, "alder_citat": null},
   {"id": "manadsanstallda", "namn": "Månadsanställda sommarvikarier", "forklaring": "Vikarier som fick en månadsanställning över sommaren i stället för ett timvikariat. Hur mycket de arbetade är inte redovisat.", "alder": "anges inte i handlingarna", "alder_kalla": null, "alder_citat": null}
  ],
  "uppgifter": [
   {"ar": 2023, "grupp": "17-aringar", "varde": 40, "kalla": "vo-del2023", "citat": "Ytterligare en del i att attrahera och bredda rekryteringsbasen är att vi inför sommaren 2023 anställt 40 stycken 17-åringar som ska arbeta hos oss, främst på våra boenden men ett par kommer även att arbeta inom hemtjänsten."},
   {"ar": 2024, "grupp": "17-aringar", "varde": 58, "kalla": "vo-ar2024", "citat": "Inför sommaren 2024 anställde förvaltningen 58 nya 17-åringar, de arbetade främst på våra vård- och omsorgsboenden men även inom hemtjänst."},
